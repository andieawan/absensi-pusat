APP_NAME="Absensi Siswa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://absensi.smkibupakusari.sch.id
# Tautan/aset dipaksa https bila APP_URL https & produksi. Isi false hanya untuk uji lewat http://IP-VM.
# APP_FORCE_HTTPS=
# Isi bila HTTPS dipasang di proxy/tunnel di depan Nginx (mis. TRUSTED_PROXIES=* atau 192.168.1.1)
TRUSTED_PROXIES=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=warning

# Database: mysql (disarankan) atau sqlite. Tabel dibuat lewat "php artisan migrate"
# atau halaman /pasang (lihat README). Database MySQL dari versi lama bisa langsung dipakai.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensi_siswa
DB_USERNAME=absensi
DB_PASSWORD=

# Tanpa tabel tambahan: sesi & cache disimpan di storage/
SESSION_DRIVER=file
SESSION_LIFETIME=720
# true = cookie sesi hanya dikirim lewat HTTPS (wajib di produksi). Isi false bila situs belum HTTPS.
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Akun Administrator pertama (dipakai SEKALI oleh /pasang atau "php artisan db:seed"
# saat tabel users masih kosong). Hapus ADMIN_PASSWORD setelah login pertama.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAMA="Administrator"

# Identitas sekolah awal & aplikasi
SCHOOL_NAME="SMK Islam Bustanul Ulum Pakusari"
ABSENSI_AUTO_BACKUP=true
ABSENSI_TIMEZONE=Asia/Jakarta
# true jika di balik Cloudflare/reverse proxy
TRUST_PROXIES=false

# --- Penyambungan ke Pusat Sekolah (lihat docs/PUSAT.md). Bawaan: mati. ---
PUSAT_ENABLED=false
PUSAT_URL=
PUSAT_CLIENT_ID=
PUSAT_CLIENT_SECRET=
PUSAT_WEBHOOK_SECRET=
# Hanya uji lokal dgn sertifikat buatan sendiri (cURL error 60): isi PUSAT_CA_BUNDLE=C:\path\rootCA.pem, atau PUSAT_VERIFY_SSL=false
#PUSAT_CA_BUNDLE=
#PUSAT_VERIFY_SSL=true
# false = sinkron data hanya lewat tombol Admin → Integrasi Pusat; true = otomatis tiap jam
PUSAT_SINKRON_OTOMATIS=false
